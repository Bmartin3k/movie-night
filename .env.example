# TMDB: free at https://www.themoviedb.org/settings/api (either the v3 "API Key" or the v4 "Read Access Token" works)
TMDB_API_KEY=
# Anthropic: https://console.anthropic.com/settings/keys  (only used by the "Ask Claude" button)
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5
# Emby: Dashboard → Advanced → API Keys → New ("movie-app"). Imports played movies into the "To rate" tab.
EMBY_URL=http://192.168.1.235:32400
EMBY_API_KEY=
# EMBY_USERS=Ben,Jess        # only these Emby users (default: all)
# EMBY_SYNC_HOURS=6          # 0 = button only

# Only TMDB_API_KEY is really needed; the rest are optional.
# PORT=8095                 # port the app is served on
# TMDB: free at https://www.themoviedb.org/settings/api (either the v3 "API Key" or the v4 "Read Access Token" works)
TMDB_API_KEY=
# Anthropic: https://console.anthropic.com/settings/keys  (only used by the "Ask Claude" button)
ANTHROPIC_API_KEY=
# OMDb: free at https://www.omdbapi.com/apikey.aspx (optional: Rotten Tomatoes + Metacritic scores, critics boost)
OMDB_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5
# Radarr (optional): adds a "Request in Radarr" button to watchlist cards. Key: Radarr → Settings → General.
RADARR_URL=
RADARR_API_KEY=
# RADARR_QUALITY_PROFILE=HD-1080p    # name or id (default: the first profile)
# RADARR_ROOT_FOLDER=/movies         # (default: the first root folder)
# The user the app runs as, and who owns ./data on the host (your `id -u` / `id -g`). Default 1000.
# PUID=1000
# PGID=1000
# BACKUP_KEEP=14            # daily database backups to keep in data/backups (0 = off)
# Emby: Dashboard → Advanced → API Keys → New ("movie-app"). Imports played movies into the "To rate" tab.
# Optional: leave both blank if you don't use Emby. Example URL: http://192.168.1.50:8096
EMBY_URL=
EMBY_API_KEY=
# EMBY_USERS=Ben,Jess        # only these Emby users (default: all)
# EMBY_SYNC_HOURS=6          # how often Emby / Jellyfin / Plex sync (0 = button only)
# Jellyfin: Dashboard → API Keys → +. Example URL: http://192.168.1.50:8096
JELLYFIN_URL=
JELLYFIN_API_KEY=
# JELLYFIN_USERS=Ben,Jess
# Plex: the server owner's X-Plex-Token. Example URL: http://192.168.1.50:32400
PLEX_URL=
PLEX_TOKEN=
# PLEX_USERS=Ben,Jess        # Plex account names (default: all, including managed/home users)
